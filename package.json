{
  "name": "teamtrail-workspace",
  "version": "0.1.0",
  "author": "Teamtrail",
  "homepage": "https://teamtrail.app",
  "bugs": {
    "url": "https://github.com/teamtrailhq/teamtrail/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run seed && npm run dev:keep",
    "dev:keep": "npm run dev -w @teamtrail/lookout",
    "dev:empty": "node scripts/dev-empty.mjs",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:pair": "node scripts/dev-pair.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "registry:local": "node scripts/registry-local.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test && npm run verify:mcp",
    "seed": "esbuild scripts/seed-dev.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/seed-dev.mjs && node node_modules/.cache/seed-dev.mjs",
    "start": "node packages/cli/dist/cli.js",
    "pack": "npm pack -w teamtrail --pack-destination .",
    "dev:avatar": "npm run dev -w @teamtrail/scout-avatar"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "playwright-core": "^1.48.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamtrailhq/teamtrail.git"
  }
}
